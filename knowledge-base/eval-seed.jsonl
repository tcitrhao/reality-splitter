{"id":"EX-009","kind":"positive","scenario":"假倒计时","modality":"interface","input":"课程页面显示“仅剩 06:13，今天最后价 999 元”，刷新后倒计时重新从 09:59 开始。","expectedSignals":[{"patternId":"UIX-02","status":"observed","evidenceSpan":"刷新后倒计时重新"},{"patternId":"PSY-06","status":"observed","evidenceSpan":"今天最后价"}],"evidenceStatus":"supported","riskLevel":"medium","nextActionMustInclude":["忽略倒计时","比较历史价格和退款条件"],"mustNotClaim":["课程内容一定无价值"]}
{"id":"EX-010","kind":"positive","scenario":"语音克隆求救","modality":"audio","input":"来电声音很像女儿，对方说手机马上被收走，要求保持通话并秘密向一个虚拟币地址转账。","expectedSignals":[{"patternId":"MED-03","status":"possible","evidenceSpan":"声音很像女儿"},{"patternId":"SCM-09","status":"observed","evidenceSpan":"保持通话并秘密"},{"patternId":"SCM-10","status":"observed","evidenceSpan":"虚拟币地址转账"}],"evidenceStatus":"unverifiable","riskLevel":"urgent","nextActionMustInclude":["挂断并用已知号码回拨","联系第二位亲友"],"mustNotClaim":["声音相似即可确认本人"]}
