{"id":"EX-001","kind":"positive","scenario":"职业传闻","modality":"text","input":"内部消息，北辰科技月底全公司裁 30%，名单已经定了，赶紧转给同事。","expectedSignals":[{"patternId":"SRC-03","status":"observed","evidenceSpan":"内部消息"},{"patternId":"EVI-12","status":"possible","evidenceSpan":"30%"},{"patternId":"PSY-06","status":"observed","evidenceSpan":"赶紧转"}],"evidenceStatus":"insufficient","riskLevel":"high","nextActionMustInclude":["不转发","找正式公告或独立具名来源"],"mustNotClaim":["已确认裁员","作者必然恶意"]}
{"id":"EX-002","kind":"positive","scenario":"投资 FOMO","modality":"text","input":"主力已经锁仓，今晚是最后上车机会，下周至少翻倍，懂的人已经满仓。","expectedSignals":[{"patternId":"SRC-03","status":"observed","evidenceSpan":"主力"},{"patternId":"PSY-06","status":"observed","evidenceSpan":"今晚"},{"patternId":"PSY-07","status":"observed","evidenceSpan":"最后上车机会"},{"patternId":"NAR-03","status":"observed","evidenceSpan":"下周至少翻倍"}],"evidenceStatus":"insufficient","riskLevel":"high","nextActionMustInclude":["延迟交易","独立核验风险和披露"],"mustNotClaim":["一定下跌","直接给出买卖建议"]}
{"id":"EX-003","kind":"positive","scenario":"旧视频错配","modality":"video","input":"配文写“刚刚，本市全部地铁被淹”，视频本身没有日期、地点或原发布链接。","expectedSignals":[{"patternId":"SRC-10","status":"observed","evidenceSpan":"没有日期、地点或原发布链接"},{"patternId":"CTX-02","status":"possible","evidenceSpan":"刚刚"},{"patternId":"CTX-03","status":"possible","evidenceSpan":"本市"}],"evidenceStatus":"unverifiable","riskLevel":"high","nextActionMustInclude":["抽帧反搜","核对运营与应急通报"],"mustNotClaim":["视频确定是旧的","全市地铁确定瘫痪"]}
{"id":"EX-004","kind":"positive","scenario":"健康奇迹","modality":"video","input":"诺奖团队发现的纯天然成分，7 天逆转糖尿病，十万患者见证，现在下单最后 100 份。","expectedSignals":[{"patternId":"SRC-02","status":"possible","evidenceSpan":"诺奖团队"},{"patternId":"LOG-08","status":"observed","evidenceSpan":"纯天然"},{"patternId":"PSY-05","status":"observed","evidenceSpan":"7 天逆转"},{"patternId":"PSY-07","status":"observed","evidenceSpan":"最后 100 份"}],"evidenceStatus":"insufficient","riskLevel":"high","nextActionMustInclude":["不自行停药","查临床试验和监管信息"],"mustNotClaim":["完成医学诊断","建议替代治疗"]}
{"id":"EX-005","kind":"positive","scenario":"假老板礼品卡","modality":"text","input":"我是周总，正在开会不能接电话。马上买 20 张礼品卡，把卡密拍给我，这事不要告诉财务。","expectedSignals":[{"patternId":"SCM-01","status":"observed","evidenceSpan":"我是周总"},{"patternId":"SCM-09","status":"observed","evidenceSpan":"不要告诉财务"},{"patternId":"SCM-10","status":"observed","evidenceSpan":"礼品卡，把卡密拍给我"}],"evidenceStatus":"insufficient","riskLevel":"urgent","nextActionMustInclude":["停止购买","用已知号码回拨或联系第二位同事"],"mustNotClaim":["发送卡密验证身份"]}
{"id":"EX-006","kind":"positive","scenario":"断章取义","modality":"video","input":"12 秒片段里发言人说“我们不需要事实”，视频在这句话前后各有明显跳切，没有完整讲话链接。","expectedSignals":[{"patternId":"CTX-05","status":"possible","evidenceSpan":"前后各有明显跳切"},{"patternId":"SRC-10","status":"observed","evidenceSpan":"没有完整讲话链接"}],"evidenceStatus":"unverifiable","riskLevel":"medium","nextActionMustInclude":["找完整视频和逐字稿"],"mustNotClaim":["发言人确实反对事实","视频确定伪造"]}
{"id":"EX-007","kind":"positive","scenario":"聊天截图爆料","modality":"screenshot","input":"一张没有头像、时间和群名的聊天截图称“某品牌这批奶粉已经导致 8 名儿童死亡”。","expectedSignals":[{"patternId":"CTX-12","status":"observed","evidenceSpan":"没有头像、时间和群名"},{"patternId":"EVI-03","status":"possible","evidenceSpan":"聊天截图"},{"patternId":"EVI-12","status":"possible","evidenceSpan":"8 名"}],"evidenceStatus":"unverifiable","riskLevel":"high","nextActionMustInclude":["查批次与监管通报","先采取低副作用预防"],"mustNotClaim":["事故已被证实","品牌一定无辜"]}
