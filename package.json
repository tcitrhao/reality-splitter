{
  "name": "reality-splitter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "sync:version": "node scripts/sync-version.mjs",
    "verify:build": "node scripts/verify-extension-build.mjs",
    "build": "npm run sync:version && tsc --noEmit && vite build && vite build --config vite.content.config.ts && npm run verify:build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "studio": "node scripts/content-studio.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^24.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
